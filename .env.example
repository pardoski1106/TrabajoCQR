# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.

# --- PostgreSQL en la nube (Neon o Supabase). Ver docs/despliegue-nube.md ---
# Ejemplo de forma (NO es un valor real): postgresql://USUARIO:CLAVE@HOST/BASE?sslmode=require
DATABASE_URL=

# --- RabbitMQ (docker compose up -d rabbitmq) ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=cqrs.eventos

# --- Servidor ---
PORT=3000
HOST=0.0.0.0
# Componentes a ejecutar en este proceso: api, projector, broadcast (separados por coma)
ROLES=api,projector,broadcast
# Origen permitido por CORS (el cliente web de Vite usa 5173)
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# --- Solo para pruebas de integracion (base local o de pruebas, NO la de produccion) ---
TEST_DATABASE_URL=
