{
  "name": "@cqrs/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Servidor CQRS: API de comandos y consultas, proyector y puente de broadcast",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "migrate": "tsx src/db/migrateCli.ts",
    "verify:db": "tsx src/db/verifyCli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "amqplib": "^0.10.4",
    "fastify": "^5.0.0",
    "mongodb": "^7.9.1",
    "pg": "^8.13.0",
    "pino": "^9.0.0",
    "socket.io": "^4.8.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.5",
    "@types/pg": "^8.11.0",
    "socket.io-client": "^4.8.0",
    "vitest": "^2.1.0"
  }
}
